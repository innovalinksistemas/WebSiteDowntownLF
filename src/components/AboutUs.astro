---
import { useTranslations } from "../i18n/utils";
const t = useTranslations(Astro.currentLocale);
const VIDEO_ID = "c8maA-QJGYc";
---

<section id="explorar" class="about-us-section">
  <div class="about-us-inner">
    <p class="about-us-kicker">{t("about.kicker")}</p>

    <div class="about-us-title-wrap">
      <span class="about-us-line" aria-hidden="true"></span>
      <h2 class="about-us-title">{t("about.title")}</h2>
      <span class="about-us-line" aria-hidden="true"></span>
    </div>

    <p class="about-us-copy">{t("about.copy")}</p>
    <p class="about-us-copy">{t("about.copy2")}</p>
    <p class="about-us-copy">{t("about.copy3")}</p>

    <div
      class="about-us-ratings"
      aria-label={t("about.ratings.aria")}
    >
      <div class="about-us-ratings-grid">
        <article class="about-us-rating-item">
          <p class="about-us-rating-source">Google</p>
          <p class="about-us-rating-value">4.3<span>/5</span></p>
        </article>

        <article class="about-us-rating-item">
          <p class="about-us-rating-source">TripAdvisor</p>
          <p class="about-us-rating-value">4.4<span>/5</span></p>
        </article>

        <article class="about-us-rating-item">
          <p class="about-us-rating-source">Booking.com</p>
          <p class="about-us-rating-value">8.1<span>/10</span></p>
        </article>

        <article class="about-us-rating-item">
          <p class="about-us-rating-source">Expedia</p>
          <p class="about-us-rating-value">8.8<span>/10</span></p>
        </article>
      </div>
    </div>

    <figure class="about-us-media">
      <!--
        Fachada: el iframe de YouTube (~1 MB de JS, cookies y fuentes de
        terceros) solo se inyecta cuando el visitante pulsa reproducir.
      -->
      <div
        class="responsive-iframe-container yt-facade"
        data-yt-id={VIDEO_ID}
        data-yt-title={t("about.video.title")}
      >
        <button type="button" class="yt-facade-btn" aria-label={t("about.video.play")}>
          <img
            class="yt-facade-thumb"
            src={`https://i.ytimg.com/vi/${VIDEO_ID}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
          <span class="yt-facade-play" aria-hidden="true"></span>
        </button>
      </div>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".yt-facade").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = box.dataset.ytTitle ?? "";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
      box.replaceChildren(iframe);
    });
  });
</script>
