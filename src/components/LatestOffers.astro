---
import { Picture } from "astro:assets";
import { useTranslations } from "../i18n/utils";
import imgRomantico1 from "../assets/offers/romantico-1.jpg";
import imgRomantico2 from "../assets/offers/romantico-2.jpg";
import imgPuentes from "../assets/offers/puentes.jpg";
import imgRafting from "../assets/offers/rafting.jpg";

const t = useTranslations(Astro.currentLocale);
const sbLang = Astro.currentLocale === "en" ? "EN" : "ES";

/** Anchos reales de la card en .latest-offers-grid. */
const OFFER_SIZES = "(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 24vw";

const packages = [
  {
    title: t("offers.p1.title"),
    subtitle: t("offers.p1.subtitle"),
    description: t("offers.p1.desc"),
    image: imgRomantico1,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70564?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p2.title"),
    subtitle: t("offers.p2.subtitle"),
    description: t("offers.p2.desc"),
    image: imgRomantico2,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70563?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p3.title"),
    subtitle: t("offers.p3.subtitle"),
    description: t("offers.p3.desc"),
    image: imgPuentes,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70571?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p4.title"),
    subtitle: t("offers.p4.subtitle"),
    description: t("offers.p4.desc"),
    image: imgRafting,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70572?lang=${sbLang}`,
  },
];
---

<section id="ofertas" class="latest-offers-section">
	<div class="latest-offers-inner">
		<div class="latest-offers-header">
			<div class="latest-offers-title-wrap">
				<span class="latest-offers-line" aria-hidden="true"></span>
				<h2 class="latest-offers-title">{t("offers.title")}</h2>
			</div>
			<p class="latest-offers-copy">
				{t("offers.copy")}
			</p>
		</div>

		<div class="latest-offers-grid">
			{
				packages.map((pkg) => (
					<article class="offer-card">
						<a href={pkg.href} class="offer-media-link" aria-label={`Ver paquete ${pkg.title}`} target="_blank" rel="noopener noreferrer">
							<Picture
									src={pkg.image}
									alt={pkg.title}
									formats={["avif", "webp"]}
									fallbackFormat="jpeg"
									width={900}
									widths={[360, 600, 900]}
									sizes={OFFER_SIZES}
									layout="none"
									loading="lazy"
									decoding="async"
								/>
						</a>
						<div class="offer-card-body">
							<h3 class="offer-card-title">{pkg.title}</h3>
							<p class="offer-card-subtitle">{pkg.subtitle}</p>
							<p class="offer-card-desc">{pkg.description}</p>
							<a href={pkg.href} class="offer-card-link" target="_blank" rel="noopener noreferrer">{t("offers.cta")}</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
