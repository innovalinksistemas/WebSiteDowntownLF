---
import { Picture } from "astro:assets";
import { useTranslations } from "../i18n/utils";
import imgRomantico1 from "../assets/offers/romantico-1.jpg";
import imgRomantico2 from "../assets/offers/romantico-2.jpg";
import imgPuentes from "../assets/offers/puentes.jpg";
import imgRafting from "../assets/offers/rafting.jpg";
// Foto de la galería oficial de Hot Springs Pura Vida (hotspringspuravida.com),
// socio del paquete. Conviene tener su visto bueno por escrito para usarla.
import imgGreenSeason from "../assets/offers/green-season-puravida.jpg";

const t = useTranslations(Astro.currentLocale);
const sbLang = Astro.currentLocale === "en" ? "EN" : "ES";

/** Anchos reales de la card en .latest-offers-grid. */
const OFFER_SIZES = "(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 24vw";

/** Anchos reales de la tarjeta destacada (ocupa las dos columnas). */
const FEATURED_SIZES = "(max-width: 640px) 92vw, (max-width: 1024px) 92vw, 46vw";

const WA_NUMBER = "50685274677";
const waHref = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(t("offers.green.wa"))}`;

/**
 * Paquete destacado de temporada. Va primero y ocupa todo el ancho de la
 * rejilla; se reserva por WhatsApp (no existe en SimpleBooking) y lleva el
 * ribbon del vehículo gratis sobre la foto, como pidió el hotel.
 */
const featured = {
  title: t("offers.green.title"),
  subtitle: t("offers.green.subtitle"),
  description: t("offers.green.desc"),
  ribbon: t("offers.green.ribbon"),
  from: t("offers.green.from"),
  price: t("offers.green.price"),
  priceUnit: t("offers.green.priceUnit"),
  tiers: t("offers.green.tiers"),
  fine: t("offers.green.fine"),
  cta: t("offers.green.cta"),
  image: imgGreenSeason,
  href: waHref,
};

const packages = [
  {
    title: t("offers.p1.title"),
    subtitle: t("offers.p1.subtitle"),
    description: t("offers.p1.desc"),
    image: imgRomantico1,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70564?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p2.title"),
    subtitle: t("offers.p2.subtitle"),
    description: t("offers.p2.desc"),
    image: imgRomantico2,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70563?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p3.title"),
    subtitle: t("offers.p3.subtitle"),
    description: t("offers.p3.desc"),
    image: imgPuentes,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70571?lang=${sbLang}&cur=USD`,
  },
  {
    title: t("offers.p4.title"),
    subtitle: t("offers.p4.subtitle"),
    description: t("offers.p4.desc"),
    image: imgRafting,
    href: `https://www.simplebooking.it/ibe2/hotel/9184/package/70572?lang=${sbLang}`,
  },
];
---

<section id="ofertas" class="latest-offers-section">
	<div class="latest-offers-inner">
		<div class="latest-offers-header">
			<div class="latest-offers-title-wrap">
				<span class="latest-offers-line" aria-hidden="true"></span>
				<h2 class="latest-offers-title">{t("offers.title")}</h2>
			</div>
			<p class="latest-offers-copy">
				{t("offers.copy")}
			</p>
		</div>

		<div class="latest-offers-grid">
			<article class="offer-card offer-card--featured">
				<a href={featured.href} class="offer-media-link" aria-label={`${featured.cta}: ${featured.title}`} target="_blank" rel="noopener noreferrer">
					<Picture
						src={featured.image}
						alt={featured.title}
						formats={["avif", "webp"]}
						fallbackFormat="jpeg"
						width={1200}
						widths={[480, 800, 1200]}
						sizes={FEATURED_SIZES}
						layout="none"
						loading="lazy"
						decoding="async"
					/>
					<span class="offer-ribbon">{featured.ribbon}</span>
				</a>
				<div class="offer-card-body">
					<h3 class="offer-card-title">{featured.title}</h3>
					<p class="offer-card-subtitle">{featured.subtitle}</p>
					<p class="offer-card-price">
						<span class="offer-card-price-from">{featured.from}</span>
						<span class="offer-card-price-value">{featured.price}</span>
						<span class="offer-card-price-unit">{featured.priceUnit}</span>
					</p>
					<p class="offer-card-tiers">{featured.tiers}</p>
					<p class="offer-card-desc">{featured.description}</p>
					<a href={featured.href} class="offer-card-link offer-card-link--wa" target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
						{featured.cta}
					</a>
					<p class="offer-card-fine">{featured.fine}</p>
				</div>
			</article>
			{
				packages.map((pkg) => (
					<article class="offer-card">
						<a href={pkg.href} class="offer-media-link" aria-label={`Ver paquete ${pkg.title}`} target="_blank" rel="noopener noreferrer">
							<Picture
									src={pkg.image}
									alt={pkg.title}
									formats={["avif", "webp"]}
									fallbackFormat="jpeg"
									width={900}
									widths={[360, 600, 900]}
									sizes={OFFER_SIZES}
									layout="none"
									loading="lazy"
									decoding="async"
								/>
						</a>
						<div class="offer-card-body">
							<h3 class="offer-card-title">{pkg.title}</h3>
							<p class="offer-card-subtitle">{pkg.subtitle}</p>
							<p class="offer-card-desc">{pkg.description}</p>
							<a href={pkg.href} class="offer-card-link" target="_blank" rel="noopener noreferrer">{t("offers.cta")}</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
