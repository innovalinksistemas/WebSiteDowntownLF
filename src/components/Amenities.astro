---
import { useTranslations } from "../i18n/utils";
import { icon, ICON_VIEWBOX } from "../lib/icons";

const t = useTranslations(Astro.currentLocale);

/**
 * Amenidades destacadas.
 *
 * `key` es la clave del diccionario (semántica, no "01".."08", para poder
 * reordenar sin renumerar) e `icon` es el archivo de src/assets/icons.
 *
 * Nota: carga-electrica.svg existe pero no se usa — la carga para vehículos
 * eléctricos se menciona dentro del texto de Parqueo Privado, no como amenidad
 * propia. Si se quisiera destacar aparte, el icono ya está listo.
 */
const amenities = [
  { key: "location", icon: "ubicacion" },
  { key: "pool", icon: "piscina" },
  { key: "dining", icon: "restaurante" },
  { key: "breakfast", icon: "room-service" },
  { key: "parking", icon: "estacionamiento" },
  { key: "wifi", icon: "wifi" },
  { key: "concierge", icon: "concierge" },
  { key: "frontdesk", icon: "recepcion" },
] as const;
---

<section id="bienestar" class="amenities-section">
	<div class="amenities-inner">
		<div class="amenities-head">
			<p class="amenities-kicker">{t("amenities.kicker")}</p>
			<h2 class="amenities-title">{t("amenities.title")}</h2>
			<p class="amenities-subtitle">{t("amenities.subtitle")}</p>
		</div>

		<div class="amenities-grid">
			{
				amenities.map((amenity, index) => (
					<article class={`amenity-card ${index % 2 === 1 ? "amenity-card-shift" : ""}`}>
						<div class="amenity-icon-wrap" aria-hidden="true">
							{/* Iconos de relleno: el color lo hereda de .amenity-icon-wrap. */}
							<svg
								viewBox={ICON_VIEWBOX}
								class="amenity-icon"
								fill="currentColor"
								set:html={icon(amenity.icon)}
							/>
						</div>

						<h3 class="amenity-title">{t(`amenities.${amenity.key}.title`)}</h3>
						<p class="amenity-description">{t(`amenities.${amenity.key}.desc`)}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
