---
import { useTranslations } from "../i18n/utils";
import { icon, ICON_VIEWBOX } from "../lib/icons";

const t = useTranslations(Astro.currentLocale);

/**
 * Amenidades destacadas.
 *
 * `key` es la clave del diccionario (semántica, no "01".."08", para poder
 * reordenar sin renumerar) e `icon` es el archivo de src/assets/icons.
 *
 * Nota: carga-electrica.svg existe pero no se usa — la carga para vehículos
 * eléctricos se menciona dentro del texto de Parqueo Privado, no como amenidad
 * propia. Si se quisiera destacar aparte, el icono ya está listo.
 */
const amenities = [
  { key: "location", icon: "ubicacion" },
  { key: "pool", icon: "piscina" },
  { key: "dining", icon: "restaurante" },
  { key: "breakfast", icon: "room-service" },
  { key: "parking", icon: "estacionamiento" },
  { key: "wifi", icon: "wifi" },
  { key: "concierge", icon: "concierge" },
  { key: "frontdesk", icon: "recepcion" },
] as const;
---

<section id="bienestar" class="amenities-section">
	<div class="amenities-inner">
		<div class="amenities-head">
			<p class="amenities-kicker">{t("amenities.kicker")}</p>
			<h2 class="amenities-title">{t("amenities.title")}</h2>
			<p class="amenities-subtitle">{t("amenities.subtitle")}</p>
		</div>

		{/*
			En móvil esto es un carrusel horizontal con scroll-snap (ver
			.amenities-grid en global.css); de 700px en adelante sigue siendo la
			rejilla de siempre. El aria-label solo aplica cuando hay scroll, pero
			es inocuo en escritorio y evita duplicar el markup por breakpoint.
		*/}
		<div class="amenities-grid" aria-label={t("amenities.carousel.aria")}>
			{
				amenities.map((amenity, index) => (
					<article class={`amenity-card ${index % 2 === 1 ? "amenity-card-shift" : ""}`}>
						<div class="amenity-icon-wrap" aria-hidden="true">
							{/* Iconos de relleno: el color lo hereda de .amenity-icon-wrap. */}
							<svg
								viewBox={ICON_VIEWBOX}
								class="amenity-icon"
								fill="currentColor"
								set:html={icon(amenity.icon)}
							/>
						</div>

						<h3 class="amenity-title">{t(`amenities.${amenity.key}.title`)}</h3>
						<p class="amenity-description">{t(`amenities.${amenity.key}.desc`)}</p>
					</article>
				))
			}
		</div>

		{/*
			Puntos de posición del carrusel. Decorativos: el contenido ya está
			completo en la lista de arriba y se recorre por scroll, así que para
			un lector de pantalla esto sería ruido duplicado.
		*/}
		<div class="amenities-dots" aria-hidden="true">
			{amenities.map(() => <span class="amenities-dot" />)}
		</div>
	</div>
</section>

<script>
	/*
	 * Sincroniza los puntos con la tarjeta visible del carrusel.
	 *
	 * Se calcula desde `scrollLeft` en vez de con IntersectionObserver: con
	 * scroll-snap las tarjetas son de ancho uniforme, así que el índice es una
	 * división — sin observers ni umbrales que afinar, y funciona igual aunque
	 * el navegador esté animando el snap.
	 *
	 * Si este script no llega a ejecutarse, el carrusel sigue funcionando: los
	 * puntos son un adorno, no el mecanismo de navegación.
	 */
	const grid = document.querySelector<HTMLElement>(".amenities-grid");
	const dots = [...document.querySelectorAll<HTMLElement>(".amenities-dot")];
	const cards = grid ? [...grid.querySelectorAll<HTMLElement>(".amenity-card")] : [];

	if (grid && cards.length > 1 && dots.length === cards.length) {
		// Distancia entre dos tarjetas = ancho + gap. Se mide una vez y se
		// cachea: leer offsetLeft fuerza reflow, y hacerlo en cada evento de
		// scroll sería pagar un recálculo de layout por frame de swipe.
		let step = 0;
		let current = -1;

		const measure = () => {
			step = cards[1].offsetLeft - cards[0].offsetLeft;
		};

		const sync = () => {
			if (step <= 0) return;
			const i = Math.max(
				0,
				Math.min(cards.length - 1, Math.round(grid.scrollLeft / step)),
			);
			// Durante un swipe la mayoría de eventos caen en la misma tarjeta;
			// sin esta salida se reescribirían los 8 puntos en cada uno.
			if (i === current) return;
			current = i;
			dots.forEach((d, j) => d.toggleAttribute("data-active", i === j));
		};

		measure();
		sync();

		grid.addEventListener("scroll", sync, { passive: true });

		// El ancho de tarjeta es un % del viewport: al rotar el móvil cambia y
		// el paso cacheado dejaría de valer.
		window.addEventListener(
			"resize",
			() => {
				measure();
				current = -1;
				sync();
			},
			{ passive: true },
		);
	}
</script>
