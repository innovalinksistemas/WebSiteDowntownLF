---
/**
 * Seguimiento de marketing. IDs tomados de la web en producción (sept. 2026):
 * - Google Ads (gtag)   AW-740176607
 * - Google Analytics 4  G-4S6PWSDGNR (mismo gtag.js; config adicional)
 * - Meta Pixel          2140720136664838
 *
 * Todo va con `is:inline` para que Astro no lo convierta en módulos diferidos
 * y los snippets se ejecuten exactamente como los entregan las plataformas.
 */
/*
 * GTM-WPQ8CTD4 se retiró el 2026-09-09. El contenedor estaba VACÍO
 * ("tags":[], "predicates":[], "rules":[]) — comprobado descargando gtm.js —
 * así que costaba 114.9 KB por visita y no disparaba absolutamente nada.
 *
 * Quien mide de verdad hoy es gtag: Ads y GA4. Por eso se queda.
 *
 * PARA VOLVER A USAR GTM: no basta con pegar el snippet aquí. La rama
 * `perf/consolidar-medicion` ya tiene la versión buena, que carga SOLO el
 * contenedor y mete Ads, GA4 y Meta dentro como etiquetas. Publicarla exige
 * configurar antes el contenedor; los pasos están en esa rama.
 */
export const ADS_ID = "AW-740176607";
export const GA4_ID = "G-4S6PWSDGNR";
export const META_PIXEL_ID = "2140720136664838";
---

<!--
  Google Ads, GA4 y Meta Pixel se inicializan en `load` (o a los 3,5 s como
  máximo). Cargados de inmediato competían por ancho de banda con las fuentes
  del título y retrasaban el LCP en móvil; el pageview se sigue registrando en
  cada visita que termina de cargar.
-->
<script is:inline define:vars={{ ADS_ID, GA4_ID, META_PIXEL_ID }}>
  (function () {
    var started = false;
    function start() {
      if (started) return;
      started = true;


      /* Google Ads + Google Analytics 4 (gtag.js) */
      var g = document.createElement("script");
      g.async = true;
      g.src = "https://www.googletagmanager.com/gtag/js?id=" + ADS_ID;
      document.head.appendChild(g);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", ADS_ID);
      gtag("config", GA4_ID);

      /* Meta Pixel */
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      window.fbq("init", META_PIXEL_ID);
      window.fbq("track", "PageView");
    }

    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
    window.setTimeout(start, 3500);
  })();
</script>
<noscript
  ><img
    height="1"
    width="1"
    style="display:none"
    src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
    alt=""
  /></noscript>
