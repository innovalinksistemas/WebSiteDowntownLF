---
/**
 * Seguimiento de marketing. IDs tomados de la web en producción (sept. 2026):
 * - Google Ads (gtag)   AW-740176607
 * - Google Analytics 4  G-JT4LXZ6YQH (mismo gtag.js; config adicional). Sustituye
 *   a G-4S6PWSDGNR desde el 2026-09-18: propiedad nueva entregada por la agencia.
 * - Meta Pixel          2140720136664838
 *
 * Todo va con `is:inline` para que Astro no lo convierta en módulos diferidos
 * y los snippets se ejecuten exactamente como los entregan las plataformas.
 */
/*
 * GTM-WPQ8CTD4 se retiró el 2026-09-09. El contenedor estaba VACÍO
 * ("tags":[], "predicates":[], "rules":[]) — comprobado descargando gtm.js —
 * así que costaba 114.9 KB por visita y no disparaba absolutamente nada.
 *
 * GTM-MNZ5SFXQ es el contenedor nuevo de la agencia (Xpider), añadido el
 * 2026-09-18. Ese día estaba publicado pero VACÍO, así que convive con gtag
 * y Meta sin duplicar nada.
 *
 * ¡OJO! En cuanto el contenedor publique etiquetas de Google Ads, GA4 o Meta
 * hay que quitar de aquí el gtag y el píxel directos, o cada pageview y cada
 * conversión se contarán dos veces. La rama `perf/consolidar-medicion` ya
 * tiene la versión "solo GTM".
 */
export const GTM_ID = "GTM-MNZ5SFXQ";
export const ADS_ID = "AW-740176607";
export const GA4_ID = "G-JT4LXZ6YQH";
export const META_PIXEL_ID = "2140720136664838";

/*
 * PostHog (analítica de producto). Token y host salen del entorno; sin ellos
 * no se carga. Va en el mismo arranque diferido que el resto: cargado en el
 * <head> bajaba ~214 KB y 365 ms de hilo principal dentro de la ventana del
 * LCP (PageSpeed móvil: 86 → 72, LCP 3,5 s → 6 s; medido el 2026-09-18).
 */
const { PUBLIC_POSTHOG_PROJECT_TOKEN: POSTHOG_KEY, PUBLIC_POSTHOG_HOST: POSTHOG_HOST } = import.meta.env;
if (import.meta.env.DEV && (!POSTHOG_KEY || !POSTHOG_HOST)) {
  console.warn("PostHog desactivado: faltan PUBLIC_POSTHOG_PROJECT_TOKEN o PUBLIC_POSTHOG_HOST.");
}
---

<!--
  GTM, Google Ads, GA4, Meta Pixel y PostHog se inicializan con la primera interacción del
  usuario o 4 s después de `load`, lo que ocurra antes. Cargados antes
  competían con el hero y hundían el LCP móvil. Solo se pierde el pageview de
  quien se va sin tocar la página en sus primeros ~5 s.
-->
<script is:inline define:vars={{ GTM_ID, ADS_ID, GA4_ID, META_PIXEL_ID, POSTHOG_KEY, POSTHOG_HOST }}>
  (function () {
    var started = false;
    function start() {
      if (started) return;
      started = true;

      /* Google Tag Manager (snippet oficial, solo que diferido) */
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var t = document.createElement("script");
      t.async = true;
      t.src = "https://www.googletagmanager.com/gtm.js?id=" + GTM_ID;
      document.head.appendChild(t);

      /* Google Ads + Google Analytics 4 (gtag.js) */
      var g = document.createElement("script");
      g.async = true;
      g.src = "https://www.googletagmanager.com/gtag/js?id=" + ADS_ID;
      document.head.appendChild(g);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", ADS_ID);
      gtag("config", GA4_ID);

      /* Meta Pixel */
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      window.fbq("init", META_PIXEL_ID);
      window.fbq("track", "PageView");

      /*
       * PostHog (snippet oficial). Los `window.posthog?.capture` de los CTAs
       * llegan con el arranque ya hecho: `pointerdown` precede al `click`, y
       * el stub encola los eventos hasta que baja array.js.
       */
      if (POSTHOG_KEY && POSTHOG_HOST) {
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        window.posthog.init(POSTHOG_KEY, {
          api_host: POSTHOG_HOST,
          defaults: "2026-01-30",
          capture_exceptions: {
            capture_unhandled_errors: true,
            capture_unhandled_rejections: true,
            capture_console_errors: false,
          },
        });
      }
    }

    /*
     * Primera interacción, o 4 s después de `load`. Arrancar justo en `load`
     * no bastaba: en móvil `load` llega antes que el LCP, y PageSpeed (que
     * simula 4G a partir de la traza real) metía los ~600 KB de gtag + Meta en
     * la cadena del LCP. Según la corrida, el LCP salía en 1,7 s o en 10 s.
     */
    var EVENTS = ["pointerdown", "keydown", "touchstart", "scroll", "wheel"];
    function onFirstInput() {
      EVENTS.forEach(function (e) {
        window.removeEventListener(e, onFirstInput, { passive: true });
      });
      start();
    }
    EVENTS.forEach(function (e) {
      window.addEventListener(e, onFirstInput, { passive: true });
    });

    /*
     * Tráfico pagado (o etiquetado): se mide en `load`, sin esperar. Si el
     * primer clic es "Reservar", el enlace a simplebooking.it tiene que salir
     * ya decorado por gtag (_gl) para no romper la atribución entre dominios,
     * y el gclid tiene que quedar guardado aunque navegue enseguida.
     * PageSpeed entra sin estos parámetros, así que no le afecta.
     */
    var PAID = /[?&](gclid|gbraid|wbraid|gad_source|fbclid|utm_[a-z]+)=/i.test(
      window.location.search
    );
    function afterLoad() {
      if (PAID) start();
      else window.setTimeout(start, 4000);
    }
    if (document.readyState === "complete") afterLoad();
    else window.addEventListener("load", afterLoad, { once: true });
  })();
</script>
<noscript
  ><img
    height="1"
    width="1"
    style="display:none"
    src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
    alt=""
  /></noscript>
