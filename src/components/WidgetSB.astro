---
import { getLang, useTranslations } from "../i18n/utils";

/**
 * Motor de reservas SimpleBooking (SyncroBox).
 *
 * Antes era WidgetSB.html, así que `CodLang` estaba fijo en 'EN' y el buscador
 * salía en inglés también en las páginas en español.
 *
 * NOTA para el negocio: `Currency` sigue en USD en ambos idiomas. Las landings
 * de paquetes cotizan en colones, así que probablemente convenga CRC para el
 * público nacional — pero eso depende de qué monedas tenga habilitadas la
 * cuenta de SimpleBooking, así que no se cambia sin confirmarlo.
 */
const lang = getLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const codLang = lang === "en" ? "EN" : "ES";
const currency = "USD";

/**
 * De 768px en adelante el buscador se monta al cargar, en la barra superior.
 * En móvil no se pide nada a la red hasta que el visitante toca un botón de
 * reserva ([data-open-booking]): entonces se abre .booking-bar como panel
 * inferior y se monta el widget en ese momento. Así el buscador existe en
 * móvil sin ocupar la primera pantalla ni pagar JS de terceros de entrada.
 */
const MIN_WIDTH = 768;
---

<script is:inline define:vars={{ codLang, currency, MIN_WIDTH }}>
(function () {
  var mq = window.matchMedia('(min-width: ' + MIN_WIDTH + 'px)');
  var mounted = false;

  function mount() {
    if (mounted) return;
    mounted = true;

    (function (i, s, o, g, r, a, m) {
    i['SBSyncroBoxParam'] = r; i[r] = i[r] || function () {
        (i[r].q = i[r].q || []).push(arguments)
    }, i[r].l = 1 * new Date(); a = s.createElement(o),
    m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
})(window, document, 'script', 'https://cdn.simplebooking.it/search-box-script.axd?IDA=9184','SBSyncroBox');

SBSyncroBox({
    CodLang: codLang,
    Currency: currency,
	Styles: {Theme: "dark",
    FontFamily: '"Manrope", sans-serif',   // Coincide con la tipografía del sitio
      CustomColor: "#1e1e1e",  // Primary color (brand black)
      CustomColorHover: "#1e1e1e",  // Primary hover color
      CustomBGColor: "#f5f1eb",  // Primary background color (brand cream)
      CustomFieldBackgroundColor: "#fff",  // Calendar fields background color
      CustomLabelColor: "#1e1e1e",  // Labels color
      CustomLabelHoverColor: "#1e1e1e",  // Lobels color on hover
      CustomButtonColor:"#fff",  // Buttons color
      CustomButtonBGColor: "#b90024",  // Buttons background color (brand red)
      CustomButtonHoverBGColor:"#8f001c",  // Bottons background color on hover (brand red-dark)
      CustomIconColor:"#1e1e1e",  // Icons color
      CustomLinkColor: "#1e1e1e",  // Links color
      CustomWidgetColor: "#1e1e1e", // Widgets color
      CustomWidgetBGColor: "#fff",  // Widgets background color
      CustomWidgetElementHoverColor: "#1e1e1e",  // Widget elements color on hover
      CustomWidgetElementHoverBGColor: "#f5f1eb", // Widget elements background color on hover
      CustomBoxShadowColor:"#1e1e1e",  // Box shadows color
      CustomBoxShadowColorFocus:"#b90024",  // Box shadows color when have focus (brand red)
      CustomBoxShadowColorHover: "#aba19a",  // Box shadows color on hover
      CustomAddRoomBoxShadowColor: "#1e1e1e", // Guests widget add room button border color
      CustomIntentSelectionColor: "#1e1e1e", // Color of date range currently selected, when hovering on calendar
      CustomIntentSelectionDaysBGColor: "#eccdd2",  // Background color of intent selection cells (light red tint)
      CustomSelectedDaysColor: "#fff",  // Color of current selected range
      CustomAccentColor: "#b90024", // Calendar’s main color (brand red)
      CustomAccentColorHover: "#8f001c",  // Calendar’s hover color (brand red-dark)
      CustomCalendarBackgroundColor: "#fff", // Calendar’s background color
	},
});
  }

  if (mq.matches) mount();
  else mq.addEventListener('change', function (e) { if (e.matches) mount(); });

  /* ── Panel de reserva en móvil ─────────────────────────── */
  var sheet = document.querySelector('[data-booking-sheet]');
  var backdrop = document.querySelector('[data-booking-backdrop]');
  if (!sheet || !backdrop) return;
  // La X se busca al abrir: este script va antes que la cabecera del panel en
  // el HTML, así que en este punto aún no existe en el DOM.
  var closeBtn = null;
  var lastTrigger = null;

  function openSheet(trigger) {
    mount();
    closeBtn = closeBtn || sheet.querySelector('[data-booking-close]');
    lastTrigger = trigger || null;
    sheet.classList.add('is-open');
    backdrop.classList.add('is-open');
    document.body.classList.add('booking-open');
    sheet.setAttribute('aria-hidden', 'false');
    // El foco espera a que termine la transición: antes, el panel aún es visibility:hidden.
    if (closeBtn) window.setTimeout(function () { closeBtn.focus({ preventScroll: true }); }, 350);
    if (window.dataLayer) window.dataLayer.push({ event: 'booking_sheet_open' });
  }

  function closeSheet() {
    sheet.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    document.body.classList.remove('booking-open');
    sheet.setAttribute('aria-hidden', 'true');
    if (lastTrigger && lastTrigger.focus) lastTrigger.focus({ preventScroll: true });
  }

  document.addEventListener('click', function (e) {
    var trigger = e.target.closest && e.target.closest('[data-open-booking]');
    if (!trigger || mq.matches) return; // en escritorio el enlace sigue su curso
    e.preventDefault();
    openSheet(trigger);
  });
  backdrop.addEventListener('click', closeSheet);
  document.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('[data-booking-close]')) closeSheet();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && sheet.classList.contains('is-open')) closeSheet();
  });
  // Si el visitante gira el teléfono a un ancho de escritorio, el panel sobra.
  mq.addEventListener('change', function (e) { if (e.matches) closeSheet(); });
  sheet.setAttribute('aria-hidden', String(!mq.matches));
})();
</script>

<style is:global>
       @media  (min-width:768px) {
    input#sb-container_sb__form-field--checkavailability {
        margin-top: 0;
    }

    /* Caja flotante sobre el hero: esquinas redondeadas y padding cómodo */
    #sb-container .sb-custom-bg-color {
        padding: 14px 22px;
        border-radius: 16px;
    }

    #sb-container .sb {
        display: flex !important;
        gap: 0px;
    }

    /* Footer (código promocional + gestionar reserva):
       centrado verticalmente y apilado, con tipografía proporcional */
    #sb-container .sb__footer {
        display: flex !important;
        align-items: center;
        padding-left: 36px; /* Separa el bloque promo/gestionar del botón */
    }

    #sb-container .sb__footer-actions {
        display: flex !important;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    #sb-container .sb__footer-link--promo {
        font-size: 14px !important;
    }

    #sb-container a#sb-container_sb__footer-promo-wrapper {
        margin: 0;
    }

    #sb-container a#sb-container_sb__form-field--reservationedit {
        float: none;
        margin: 0;
        font-size: 12.5px !important;
    }

    .sb__form-field-label {
        display: none !important;
    }
}

    @media  (max-width:767px) {

        input#sb-container_sb__form-field--checkavailability {
        margin-top: 0;
    }

    #sb-container .sb-custom-bg-color {
        padding: 12px 18px;
        border-radius: 16px;
    }


    .sb__form-field-label {
        display: none !important;
    }


    }

</style>

<div class="container">
    <div class="sb-sheet-head">
        <div>
            <p class="sb-sheet-title">{t("booking.sheet.title")}</p>
            <p class="sb-sheet-sub">{t("booking.sheet.sub")}</p>
        </div>
        <button type="button" class="sb-sheet-close" data-booking-close aria-label={t("booking.sheet.close")}>
            <svg viewBox="0 0 18 18" width="16" height="16" fill="none" aria-hidden="true"><path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
    </div>
    <div id="sb-container"></div>
</div>
