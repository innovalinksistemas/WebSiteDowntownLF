---
import { Image } from "astro:assets";
import { useTranslations } from "../i18n/utils";
import heroImg from "../assets/hero.jpg";
const t = useTranslations(Astro.currentLocale);
---

<section
  class="hero relative isolate min-h-screen overflow-hidden"
  aria-label="La Fortuna Downtown Hotel — Hero"
>

  <!--
    Imagen LCP. `layout="none"` porque Tailwind ya controla la geometría por
    completo (absolute inset-0 h-full w-full object-cover) y no queremos que los
    estilos responsive compitan con esas utilidades.
    `priority` emite loading="eager" + decoding="sync" + fetchpriority="high".
    No lleva <link rel=preload>: el <img> es el primer elemento del <body>, así
    que el preload scanner ya lo encuentra en el primer bloque de parseo.
  -->
  <Image
    src={heroImg}
    alt={t("hero.img.alt")}
    class="hero-bg absolute inset-0 h-full w-full object-cover"
    layout="none"
    width={2560}
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    format="webp"
    quality={70}
    priority
  />


  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
  <div class="hero-vignette absolute inset-0" aria-hidden="true"></div>
  <div class="hero-grain absolute inset-0" aria-hidden="true"></div>

  
  <div class="hero-content relative z-10 mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-6 text-center sm:px-10">


    <p class="hero-kicker hero-anim mb-2" style={`--hero-i:0`}>
      {t("hero.kicker")}
    </p>


    <!--
      Sin `hero-anim` a propósito: es el elemento de texto LCP. Al incluirlo,
      GSAP lo pintaba, lo ocultaba (opacity:0) y lo revelaba 1.1 s después,
      retrasando el LCP y produciendo un parpadeo visible.
    -->
    <h1 class="hero-title mb-4">
      LA FORTUNA<br />DOWNTOWN
    </h1>

    
  

    
    <div class="hero-trust hero-anim mb-4" aria-label={t("hero.trust.aria")} style={`--hero-i:1`}>
      <div class="hero-trust-inner">

        
        <div class="hero-trust-item">
          <span class="hero-trust-score">8.1</span>
          <span class="hero-trust-label">Booking.com</span>
        </div>

        <div class="hero-trust-divider" aria-hidden="true"></div>

        
        <div class="hero-trust-item">
          <span class="hero-trust-score">★ 4.4</span>
          <span class="hero-trust-label">TripAdvisor</span>
        </div>

        <div class="hero-trust-divider" aria-hidden="true"></div>

        
        <!--
          El <script> de abajo lo procesa Astro (lleva TypeScript), así que no
          admite `define:vars` sin volverlo inline y perder el bundling. Los
          textos viajan por data-* y el script los lee del DOM: así el bloque
          queda traducido también en /en/, donde antes salía en español.
        -->
        <div
          class="hero-trust-item"
          id="hero-availability-block"
          hidden
          data-rooms={t("hero.avail.rooms")}
          data-room-one={t("hero.avail.room.one")}
          data-none={t("hero.avail.none")}
          data-today={t("hero.avail.today")}
          data-error={t("hero.avail.error")}
          data-error-label={t("hero.avail.error.label")}
        >
          <span class="hero-trust-score hero-trust-urgent">
            <span class="hero-urgency-dot" id="hero-avail-dot" aria-hidden="true"></span>
            <span id="hero-avail-text">{t("hero.avail.checking")}</span>
          </span>
          <span class="hero-trust-label" id="hero-avail-label">{t("hero.avail.label")}</span>
        </div>

      </div>
    </div>


    <div class="hero-actions hero-anim flex flex-col items-center justify-center gap-3 sm:flex-row" style={`--hero-i:2`}>

      <!--
        Solo móvil (ver .hero-btn-book en global.css). Es el espejo exacto de
        .booking-bar: de 768px en adelante manda el buscador de SimpleBooking y
        este botón sobra, pero por debajo no hay buscador y el hero se quedaba
        sin ninguna vía de reserva a la vista.
        Apunta a #habitaciones, igual que el CTA del header.
      -->
      <a
        href={t("header.cta.book.href")}
        class="hero-btn hero-btn-primary hero-btn-book"
        data-open-booking
        aria-label={t("hero.btn.book.aria")}
      >
        {t("hero.btn.book")}
      </a>

      <a
        href="#explorar"
        class="hero-btn hero-btn-outline"
        aria-label={t("hero.btn.explore.aria")}
      >
        {t("hero.btn.explore")}
      </a>

    </div>

    
    <p class="hero-microcopy hero-anim mt-4" style={`--hero-i:3`}>
      {t("hero.microcopy")}
    </p>

  </div>

  
  <div
    class="hero-status hero-anim absolute bottom-8 left-6 z-10 flex items-center gap-3"
    aria-label="Condiciones actuales en La Fortuna"
   style={`--hero-i:4`}>
    <div class="hero-status-line" aria-hidden="true"></div>
    <div>
      <p class="hero-status-label">{t("hero.weather.label")}</p>
      <p class="hero-status-value">
        <span class="hero-live-dot" aria-hidden="true"></span>
        <span id="hero-weather-text">· · ·</span>
      </p>
    </div>
  </div>

  
  <div class="hero-scroll-indicator hero-anim absolute bottom-8 left-1/2 z-10 -translate-x-1/2 hidden flex-col items-center gap-1 sm:flex" aria-hidden="true" style={`--hero-i:5`}>
    <span class="hero-scroll-label">Scroll</span>
    <span class="hero-scroll-arrow"></span>
  </div>

</section>


<script>

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Idioma de la página, para lo que este script escribe en tiempo de ejecución
  // (clima y disponibilidad). Layout ya emite lang="es" o lang="en" en <html>.
  const isEN = document.documentElement.lang.startsWith("en");

  /* ─── Animaciones ─────────────────────────────────────
     Entrada del contenido, Ken Burns del fondo, parpadeo de los puntos "en
     vivo" y rebote de la flecha viven en CSS (global.css, buscar hero-anim).
     Arrancan en el primer pintado sin esperar JavaScript y respetan
     prefers-reduced-motion. Antes dependían de GSAP (69 KB) en la cadena
     crítica del LCP. */

  /* ─── Clima en tiempo real — Open Meteo, caché 6 h ─── */
  (() => {
    const CACHE_KEY = 'dlf_weather_v1';
    const TTL = 6 * 60 * 60 * 1000;

    // Códigos WMO de Open Meteo. Viven aquí y no en ui.ts porque son un mapa
    // código→texto que solo consume este script; llevarlos al diccionario
    // añadiría 36 claves que ninguna plantilla usa.
    const WMO_ES: Record<number, string> = {
      0: 'Cielo despejado y soleado', 1: 'Mayormente despejado',
      2: 'Parcialmente soleado', 3: 'Parcialmente nublado',
      45: 'Nublado', 48: 'Nublado',
      51: 'Llovizna leve y algunas horas soleado', 53: 'Llovizna leve y parcialmente soleado', 55: 'Lluvia leve',
      61: 'Lluvia leve', 63: 'Lluvia leve', 65: 'Lluvia leve',
      80: 'Lluvia leve', 81: 'Lluvia leve', 82: 'Lluvia leve',
      95: 'Lluvia intensa', 96: 'Lluvia intensa', 99: 'Lluvia muy intensa',
    };

    const WMO_EN: Record<number, string> = {
      0: 'Clear and sunny', 1: 'Mostly clear',
      2: 'Partly sunny', 3: 'Partly cloudy',
      45: 'Cloudy', 48: 'Cloudy',
      51: 'Light drizzle with sunny spells', 53: 'Light drizzle, partly sunny', 55: 'Light rain',
      61: 'Light rain', 63: 'Light rain', 65: 'Light rain',
      80: 'Light rain', 81: 'Light rain', 82: 'Light rain',
      95: 'Heavy rain', 96: 'Heavy rain', 99: 'Very heavy rain',
    };

    const WMO = isEN ? WMO_EN : WMO_ES;

    async function loadWeather() {
      // Intentar caché primero
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (raw) {
          const { ts, hourly } = JSON.parse(raw);
          if (Date.now() - ts < TTL) return hourly;
        }
      } catch { /* localStorage bloqueado */ }

      const res = await fetch(
        'https://api.open-meteo.com/v1/forecast?latitude=10.4709&longitude=-84.6453' +
        '&hourly=temperature_2m,weathercode&past_days=0&forecast_days=1' +
        '&timezone=America%2FCosta_Rica'
      );
      if (!res.ok) throw new Error('weather fetch failed');
      const { hourly } = await res.json();

      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), hourly }));
      } catch { /* storage lleno */ }

      return hourly;
    }

    async function updateWeather() {
      const el = document.getElementById('hero-weather-text');
      if (!el) return;
      try {
        const hourly = await loadWeather();
        const now = new Date();
        // Encontrar el índice de la hora actual (formato "YYYY-MM-DDTHH:00")
        const pad = (n: number) => String(n).padStart(2, '0');
        const key = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:00`;
        const idx = (hourly.time as string[]).indexOf(key);
        if (idx === -1) return;
        const temp = Math.round((hourly.temperature_2m as number[])[idx]);
        const code = (hourly.weathercode as number[])[idx];
        const desc = WMO[code] ?? (isEN ? 'Current conditions' : 'Condición actual');
        el.textContent = `${desc} · ${temp}°C`;
      } catch {
        // Mantener el texto por defecto si falla
      }
    }

    updateWeather();
  })();

  /* ─── Disponibilidad real — CloudBeds ──────────────────
     Solo se muestra como aviso de escasez: cuando quedan pocas habitaciones
     (1 a SCARCITY_MAX). Con muchas libres, sin disponibilidad o si el
     servicio falla, el bloque no aparece: anunciar "14 habitaciones
     disponibles" transmite hotel vacío, y "sin disponibilidad" espanta. */
  (async () => {
    const SCARCITY_MAX = 3;
    const block = document.getElementById('hero-availability-block');
    const dot   = document.getElementById('hero-avail-dot');
    const text  = document.getElementById('hero-avail-text');
    const label = document.getElementById('hero-avail-label');
    if (!block || !dot || !text || !label) return;

    // Textos ya traducidos por Astro (ver los data-* en el markup).
    const T = block.dataset;

    try {
      const res  = await fetch('https://cloudbeds-service.onrender.com/availability');
      const data = await res.json();
      const { available, available_rooms } = data;
      const n = Number(available_rooms);

      if (!available || !Number.isFinite(n) || n < 1 || n > SCARCITY_MAX) return;

      const hoy = new Intl.DateTimeFormat(isEN ? 'en-US' : 'es-CR', {
        weekday: 'long', day: 'numeric', month: 'long',
        timeZone: 'America/Costa_Rica'
      }).format(new Date());
      // El español da el día en minúscula ("miércoles"); el inglés ya viene
      // capitalizado, así que la operación es inocua en ambos.
      const hoyLabel = (T.today ?? 'Hoy, {fecha}')
        .replace('{fecha}', hoy.charAt(0).toUpperCase() + hoy.slice(1));

      dot.style.background = '#f87171';
      dot.style.boxShadow  = '0 0 6px #f87171';
      text.textContent = n === 1
        ? (T.roomOne ?? '')
        : (T.rooms ?? '').replace('{n}', String(n));
      label.textContent = hoyLabel;
      block.hidden = false;
    } catch {
      /* Sin datos, sin bloque. */
    }
  })();

</script>