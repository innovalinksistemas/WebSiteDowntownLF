# Cabeceras para Cloudflare Pages.
#
# Cloudflare servía TODO con `max-age=14400, must-revalidate` (4 h), incluidos
# los archivos de /_astro/, que llevan hash de contenido en el nombre: si el
# contenido cambia, cambia la URL. Revalidarlos cada 4 h era gasto puro y es el
# origen del hallazgo "caché del navegador · 163 KiB" de PageSpeed.

# Assets con hash en el nombre: inmutables por construcción.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Las fuentes viven bajo /_astro/fonts/ y ya quedan cubiertas por la regla de
# arriba; esta entrada solo añade CORS, que woff2 necesita al precargarse.
/_astro/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Iconos y manifiesto: no llevan hash, así que se revalidan a diario.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

# El HTML se queda como está (4 h en el borde de Cloudflare): el sitio es
# estático y se reconstruye al publicar, así que no conviene cachearlo más.
